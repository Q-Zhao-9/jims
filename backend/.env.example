# Copy to .env and adjust. SQLite is the default for local dev without Docker.
# DATABASE_URL=sqlite:///./jims.db
#
# PostgreSQL in Docker (see repo root docker-compose.yml):
#   Dev:  docker compose up -d db
#   Prod: docker compose up -d db_prod
DATABASE_URL=postgresql://jims:jims@localhost:5432/jims
# DATABASE_URL=postgresql://jims:jims_prod@localhost:5433/jims

SECRET_KEY=change-me-to-a-long-random-string
# Include preview port if you use `npm run build && npm run preview` (default 4173).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# UPLOAD_DIR=uploads
